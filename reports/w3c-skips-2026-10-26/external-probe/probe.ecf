<?xml version="1.0" encoding="UTF-8"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-20-0" name="external_probe" uuid="E0238F92-546C-4A97-9EC4-83B04FC61059">
<target name="probe"><root class="EXTERNAL_PROBE" feature="make"/>
<option warning="true"><assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/></option>
<setting name="console_application" value="true"/><capability><concurrency support="none"/><void_safety support="all" use="all"/></capability>
<library name="base" location="$ISE_LIBRARY/library/base/base.ecf"/>
<cluster name="parser" location="$XPACT_SOURCE_ROOT/src/"/>
<cluster name="probe" location="./"/>
</target></system>