+# Runs a native command without letting stderr output (such as ec's banner)
+# become a terminating error under $ErrorActionPreference = "Stop" when the
+# output is redirected, e.g. in CI or to a log file. Returns the exit code.
+function Invoke-NativeCommand {
+	param([scriptblock] $Block)
+	$SavedErrorActionPreference = $ErrorActionPreference
+	$ErrorActionPreference = "Continue"
+	try {
+		& $Block | Out-Host
+		return $LASTEXITCODE
+	} finally {
+		$ErrorActionPreference = $SavedErrorActionPreference
+	}
+}
