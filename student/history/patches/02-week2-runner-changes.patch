+# Downloads the pinned W3C XML Test Suite ZIP once into $CacheDir, verifies its
+# SHA-256 on every run (also when reusing the cached copy), and extracts it.
+# The archive unpacks to <CacheDir>\xmlconf\xmlconf.xml.
+function Get-W3cSuite {
+	$CacheRoot = if ([System.IO.Path]::IsPathRooted($CacheDir)) { $CacheDir } else { Join-Path $RepoRoot $CacheDir }
+	New-Item -ItemType Directory -Force -Path $CacheRoot | Out-Null
+	$Archive = Join-Path $CacheRoot ([System.IO.Path]::GetFileName(([uri] $SuiteUrl).AbsolutePath))
+	$Extracted = Join-Path $CacheRoot "xmlconf"
+
+	if (-not (Test-Path -LiteralPath $Archive -PathType Leaf)) {
+		Write-Host "== xmlconf: downloading $SuiteUrl =="
+		$Temporary = "$Archive.download"
+		# Windows PowerShell 5.1 may default to TLS 1.0, which w3.org rejects;
+		# its progress bar also slows Invoke-WebRequest down considerably.
+		[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
+		$SavedProgressPreference = $ProgressPreference
+		$ProgressPreference = "SilentlyContinue"
+		try {
+			Invoke-WebRequest -Uri $SuiteUrl -OutFile $Temporary -UseBasicParsing
+			Move-Item -LiteralPath $Temporary -Destination $Archive -Force
+		} finally {
+			$ProgressPreference = $SavedProgressPreference
+			Remove-Item -LiteralPath $Temporary -Force -ErrorAction SilentlyContinue
+		}
+		$RefreshSuite = $true
+	}
+
+	$Actual = (Get-FileHash -LiteralPath $Archive -Algorithm SHA256).Hash.ToLowerInvariant()
+	if ($Actual -ne $SuiteSha256.ToLowerInvariant()) {
+		throw "W3C suite SHA-256 mismatch for ${Archive}: got $Actual, expected $SuiteSha256. Delete the file to download it again."
+	}
+
+	if ($RefreshSuite -or -not (Test-Path -LiteralPath (Join-Path $Extracted $Catalog) -PathType Leaf)) {
+		Write-Host "== xmlconf: extracting $Archive =="
+		if (Test-Path -LiteralPath $Extracted) {
+			Remove-Item -LiteralPath $Extracted -Recurse -Force
+		}
+		Add-Type -AssemblyName System.IO.Compression.FileSystem
+		[System.IO.Compression.ZipFile]::ExtractToDirectory($Archive, $CacheRoot)
+	}
+	(Resolve-Path -LiteralPath $Extracted).Path
+}
