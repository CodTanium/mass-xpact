<?xml version="1.0" encoding="UTF-8"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" name="xpact_core_regression" uuid="8B4E7D21-0F3A-4A6C-B1D9-6E25C7A93F40">
  <target name="regression">
    <root class="DR_REGRESSION_ROOT" feature="make"/>
    <option warning="warning" is_obsolete_routine_type="true">
      <assertions precondition="false" postcondition="false" check="false" invariant="false" loop="false" supplier_precondition="false"/>
    </option>
    <setting name="console_application" value="true"/>
    <setting name="dead_code_removal" value="all"/>
    <capability>
      <concurrency support="none"/>
      <void_safety support="all" use="all"/>
    </capability>
    <variable name="buffer_size" value="big"/>
    <external_object location="$XPACT_SHIFT_JIS_OBJECT">
      <condition><platform value="windows"/></condition>
    </external_object>
    <library name="base" location="$ISE_LIBRARY/library/base/base.ecf"/>
    <library name="xpact_core" location="$XPACT_CORE/library/xpact-core.ecf" readonly="true"/>
    <cluster name="backend" location="./"/>
    <cluster name="shared" location="../shared/"/>
    <cluster name="identity" location="$XPACT_PROBE_METADATA/"/>
  </target>
  <target name="regression_assertions" extends="regression">
    <option>
      <assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
    </option>
  </target>
</system>
